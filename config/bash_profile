#!/usr/bin/env bash

# I do not use bash directly
# This is just decorational

# Launches zsh if we're in Linux Subsystem for Windows
if [ -t 1 ]; then
  if command -v zsh >/dev/null 2>&1; then
    exec zsh
  else
    printf '%s\n' 'Zsh is not installed; staying in Bash. Install it with: sudo apt install zsh' >&2
  fi
fi
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
